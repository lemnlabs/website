---
import type { GetStaticPaths } from 'astro';
import { render, type CollectionEntry } from 'astro:content';
import DetailBackLink from '../../components/DetailBackLink';
import NewsroomCategoryBadge from '../../components/NewsroomCategoryBadge';
import DetailFrame from '../../components/DetailFrame';
import NewsroomArticleHeader from '../../components/NewsroomArticleHeader';
import MarkdownBody from '../../components/MarkdownBody';
import NewsroomBacklinks from '../../components/NewsroomBacklinks';
import TableOfContents, {
  TableOfContentsMobile,
} from '../../components/TableOfContents';
import Layout from '../../layouts/Layout.astro';
import { formatNewsDate, getNewsArticles } from '../../data/newsroom';
import { getVaultIndex } from '../../data/vault.mjs';

export const getStaticPaths = (async () => {
  const articles = await getNewsArticles();
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}) satisfies GetStaticPaths;

interface Props {
  article: CollectionEntry<'newsroom'>;
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const base = import.meta.env.BASE_URL;

const tocHeadings = headings.filter((h) => h.depth <= 3);
const hasToc = tocHeadings.length > 0;

const vaultIndex = getVaultIndex();
const backlinks = vaultIndex.backlinks.get(article.id) ?? [];
---

<Layout
  title={`${article.data.title} | lemnlabs`}
  description={article.data.description}
>
  <DetailFrame hasToc={hasToc}>
    {hasToc && (
      <Fragment slot="toc">
        <TableOfContents headings={tocHeadings} client:load />
      </Fragment>
    )}
    <Fragment slot="back-link">
      <DetailBackLink
        href={`${base}newsroom/`}
        label="뉴스룸 목록"
        client:load
      />
    </Fragment>
    <NewsroomArticleHeader
      slot="header"
      title={article.data.title}
      description={article.data.description}
      publishedAt={article.data.publishedAt}
      formattedDate={formatNewsDate(article.data.publishedAt)}
    >
      <Fragment slot="category">
        <NewsroomCategoryBadge
          category={article.data.category}
          base={base}
          client:load
        />
      </Fragment>
    </NewsroomArticleHeader>
    {hasToc && <TableOfContentsMobile headings={tocHeadings} client:load />}
    <MarkdownBody>
      <Content />
    </MarkdownBody>
    <NewsroomBacklinks backlinks={backlinks} />
  </DetailFrame>
</Layout>
